# --- Core ---
PORT=8787
# Use your phone (sourcing mode) on home Wi-Fi: set HOST=0.0.0.0 AND a password,
# then open http://<your-computer's-LAN-IP>:8787 on your phone (after `npm run build && npm start`).
HOST=127.0.0.1
FLIPDESK_PASSWORD=

# --- Hosting FlipDesk for other resellers (accounts) ---
# 1 = people sign up with email + password; each gets a private shop (data/users/<id>/).
# The first account is the owner. Personal keys below (mailbox, Shippo, Etsy, Shopify, FLIPDESK_TOKEN)
# only ever apply to the owner's shop. FLIPDESK_PASSWORD is not used in this mode.
FLIPDESK_MULTIUSER=
# Required for anyone after the first account to sign up. Leave blank to keep sign-ups closed.
FLIPDESK_INVITE_CODE=
# Public servers: only this email can create the first (owner) account. Required when hosted.
FLIPDESK_OWNER_EMAIL=
# Local mode only answers to localhost and PUBLIC_BASE_URL's host. Add others here (e.g. a tunnel or my-mac.local)
FLIPDESK_ALLOWED_HOSTS=
# AI requests per day for each account except the owner (listing writer, photo AI, sourcing). Default 40.
FLIPDESK_AI_DAILY_LIMIT=
# --- Paid plans (Stripe). Leave blank and everyone uses FlipDesk free. ---
# Stripe dashboard: create a Product with a monthly Price, copy its price_... id.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Webhook endpoint: https://<your address>/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=
# Test-mode keys (sk_test_..., a test price, the test webhook's secret). Flip between test and live
# on the Accounts page; with only one set, that one is used.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_WEBHOOK_SECRET=
FLIPDESK_TRIAL_DAYS=14
FLIPDESK_PRICE_LABEL=$19/month
# AI requests per day with a paid plan (trial/free use FLIPDESK_AI_DAILY_LIMIT)
FLIPDESK_AI_PAID_LIMIT=200
# Your monthly price as a number, for the revenue estimate on the Accounts page
FLIPDESK_PRICE_MONTHLY=19
# Members can make their own invite links (a free month when a friend starts paying).
# Default: on when billing is on. 1 = always, 0 = owner only.
FLIPDESK_MEMBER_INVITES=
# Rough AI cost per request, for the usage chart (check your Anthropic console for the real bill)
FLIPDESK_AI_COST_PER_CALL=0.04
# Outage alerts: tell the owner after this many failures in a row (AI, eBay, email); 0 = no "Heads up" announcement
FLIPDESK_INCIDENT_AFTER=3
FLIPDESK_AUTO_ANNOUNCE=1
# Problems fixed within this many minutes are only logged, never paged (quiet hours are set in Settings)
FLIPDESK_ALERT_AFTER_MINUTES=10
# One "come back" offer when a trial ends without a plan: % off the first month (0 = off)
FLIPDESK_WINBACK_PCT=20
# "What's new" drafts read the update history from git, or from GitHub when there's no .git folder (Docker/Fly)
FLIPDESK_GITHUB_REPO=richardsmolik/flipdesk
# A GitHub token for your repo. Read-only is enough for "what's new" drafts; give it "Issues: write" to send
# problem reports as GitHub issues (you're asked each time before anything is sent).
GITHUB_TOKEN=
# How often to prove the newest backup restores (days)
FLIPDESK_BACKUP_CHECK_DAYS=30

# --- Backups: nightly copy of every shop in data/backups (newest 7 kept) ---
# Optional off-site copy to S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3, Wasabi)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_KEEP=7

# Email for "forgot password", the weekly summary email and feedback alerts (any SMTP service).
# Links use PUBLIC_BASE_URL, so set that too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FlipDesk <no-reply@your-domain.com>

# Local token the Chrome extension uses to talk to this server (change it!)
FLIPDESK_TOKEN=change-me

# --- AI. Any one is enough; with several, FlipDesk falls back from one to the next (order: Settings -> AI). ---
# All blank = demo mode. Keys can also be pasted in Settings -> AI instead of here.
ANTHROPIC_API_KEY=          # Claude (console.anthropic.com) - the default
OPENAI_API_KEY=             # ChatGPT (platform.openai.com/api-keys)
GEMINI_API_KEY=             # Gemini / Google AI Studio (aistudio.google.com/apikey)
MOONSHOT_API_KEY=           # Kimi (platform.moonshot.ai). China-mainland keys: MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_API_KEY=           # DeepSeek (platform.deepseek.com)
# Optional: pin a model instead of the automatic choice from each provider's own list
# OPENAI_MODEL=  GEMINI_MODEL=  KIMI_MODEL=  DEEPSEEK_MODEL=
# Optional: monthly AI spending limit in dollars (also settable in Settings -> AI)
# FLIPDESK_AI_MONTHLY_BUDGET=20

# --- eBay (developer.ebay.com -> Application Keys). Leave blank for demo mode. ---
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=               # the "RuName" redirect URL name from your eBay app
EBAY_MARKETPLACE_ID=EBAY_US
# Only when hosted (PUBLIC_BASE_URL set): the verification token you enter for eBay's
# Marketplace Account Deletion endpoint  <PUBLIC_BASE_URL>/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Public HTTPS address of this FlipDesk (hosted or tunnel). Optional when running locally.
PUBLIC_BASE_URL=

# --- Etsy (etsy.com/developers) ---
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=

# --- Shopify (custom app Admin API token) ---
SHOPIFY_STORE_DOMAIN=       # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- Sale detection from email (catches sales on EVERY marketplace) ---
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords).
# Tip: a dedicated folder/label via a filter (from:poshmark.com OR from:mercari.com ...) keeps it fast.
IMAP_HOST=                  # imap.gmail.com | outlook.office365.com | imap.mail.me.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=              # app password, NOT your normal password
IMAP_MAILBOX=INBOX

# --- Buy shipping labels inside FlipDesk (Shippo). Test keys (shippo_test_...) are free. ---
SHIPPO_API_KEY=

# --- Photo editor (all optional) ---
# Background removal: any ONE of these
PHOTOROOM_API_KEY=
REMOVEBG_API_KEY=
# AI remove-objects / fix-wrinkles (also does background removal)
CLIPDROP_API_KEY=
