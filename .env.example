# --- Core ---
PORT=8787
# Use your phone (sourcing mode) on home Wi-Fi: set HOST=0.0.0.0 AND a password,
# then open http://<your-computer's-LAN-IP>:8787 on your phone (after `npm run build && npm start`).
HOST=127.0.0.1
FLIPDESK_PASSWORD=

# Local token the Chrome extension uses to talk to this server (change it!)
FLIPDESK_TOKEN=change-me

# --- AI listing writer (Claude). Leave blank to use demo mode. ---
ANTHROPIC_API_KEY=

# --- eBay (developer.ebay.com -> Application Keys). Leave blank for demo mode. ---
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=               # the "RuName" redirect URL name from your eBay app
EBAY_MARKETPLACE_ID=EBAY_US

# --- Etsy (etsy.com/developers) ---
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=

# --- Shopify (custom app Admin API token) ---
SHOPIFY_STORE_DOMAIN=       # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- Sale detection from email (catches sales on EVERY marketplace) ---
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords).
# Tip: a dedicated folder/label via a filter (from:poshmark.com OR from:mercari.com ...) keeps it fast.
IMAP_HOST=                  # imap.gmail.com | outlook.office365.com | imap.mail.me.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=              # app password, NOT your normal password
IMAP_MAILBOX=INBOX

# --- Buy shipping labels inside FlipDesk (Shippo). Test keys (shippo_test_...) are free. ---
SHIPPO_API_KEY=
