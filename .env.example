# --- Core ---
PORT=8787
# Local token the Chrome extension uses to talk to this server (change it!)
FLIPDESK_TOKEN=change-me

# --- AI listing writer (Claude). Leave blank to use demo mode. ---
ANTHROPIC_API_KEY=

# --- eBay (developer.ebay.com -> Application Keys). Leave blank for demo mode. ---
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=               # the "RuName" redirect URL name from your eBay app
EBAY_MARKETPLACE_ID=EBAY_US

# --- Etsy (etsy.com/developers) ---
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=

# --- Shopify (custom app Admin API token) ---
SHOPIFY_STORE_DOMAIN=       # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=
