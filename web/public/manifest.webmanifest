{
  "name": "FlipDesk",
  "short_name": "FlipDesk",
  "description": "Crosslisting, AI listings and inventory for resellers",
  "start_url": "/shoot",
  "scope": "/",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Shoot items", "url": "/shoot", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sourcing mode", "url": "/source", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inventory", "url": "/inventory", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
